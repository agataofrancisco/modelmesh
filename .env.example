# Modelo de variáveis de ambiente do ModelMesh. Copiar para .env LOCALMENTE (nunca commitar .env).
# Todos os valores abaixo são placeholders.
MODELMESH_ENV=dev
MODELMESH_DATABASE_URL=postgresql+psycopg://modelmesh:CHANGE_ME@127.0.0.1:5432/modelmesh
MODELMESH_REDIS_URL=redis://127.0.0.1:6379/0
# Token de administração (obrigatório para /admin/*). Gerar com: python -c "import secrets;print(secrets.token_urlsafe(32))"
MODELMESH_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
MODELMESH_FAIL_CLOSED=true
MODELMESH_LOG_LEVEL=INFO
# Opcional: exportação OTLP/HTTP (ex.: http://otel-collector:4318/v1/traces)
MODELMESH_OTEL_EXPORTER_OTLP_ENDPOINT=
# Chaves dos providers reais: o nome da variável é referenciado em providers[].api_key_env
OPENROUTER_API_KEY=CHANGE_ME_PROVIDER_KEY
